# ==============================================================================
# SAFE FIRE FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development: cp .env.example .env
# For Vercel deployment, add these keys in: Project Settings -> Environment Variables
# ==============================================================================

# Backend API & Socket.IO Base Endpoint (Required)
# Socket.IO URL will automatically be derived by stripping '/api' from VITE_API_BASE_URL
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
# Production (e.g. Vercel/Custom Domain):
# VITE_API_BASE_URL=https://firesafetyshop.in/api

# Image Base URL (Leave blank if using direct Cloudinary / external URLs)
VITE_IMAGE_BASE_URL=

# Razorpay Public Key ID (Required for customer checkout payment popup)
# e.g., rzp_test_xxxxxxxxxxxxxx or rzp_live_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# ─── Firebase Cloud Messaging (Web Push Notifications) ────────────────────────
# From Firebase Console -> Project Settings -> General -> Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# From Firebase Console -> Project Settings -> Cloud Messaging -> Web Push Certificates (VAPID key)
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

