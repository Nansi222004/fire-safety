{
  "name": "fire-safety-shop-backend",
  "version": "1.0.0",
  "description": "Fire Safety Shop Multi-Vendor E-Commerce Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test:delivery-routing": "node src/services/deliveryRouting.test.js",
    "test:wholesale-auth": "node src/services/wholesaleAuth.test.js",
    "test:wholesaler-account": "node src/middlewares/wholesalerAccount.test.js",
    "test:product-channels": "node src/services/productChannel.test.js",
    "test:product-validation": "node src/services/productValidation.test.js",
    "test:wholesale-e2e": "node src/scripts/wholesalerE2E.js",
    "test:fire-safety-e2e": "node src/scripts/fireSafetyE2E.js",
    "test:exchange-shipment": "node src/services/exchangeShipment.test.js",
    "test:assignment": "node src/services/assignment.test.js",
    "test:shiprocket-webhook": "node src/modules/user/controllers/shiprocketWebhook.test.js",
    "seed:coupons": "node src/scripts/seedCoupons.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e/api",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:server": "node tests/e2e-server/start.mjs",
    "test:financial-audit": "node --test --test-force-exit tests/unit/financialAudit.regression.test.mjs",
    "test:wallet-db": "node --test --test-force-exit tests/unit/walletAtomicity.db.test.mjs",
    "test:checkout-db": "node --test --test-force-exit tests/unit/checkoutPricing.db.test.mjs",
    "test:service-db": "node --test --test-force-exit tests/unit/serviceFlow.db.test.mjs",
    "test:return-db": "node --test --test-force-exit tests/unit/returnRefund.db.test.mjs",
    "test:ridercod-db": "node --test --test-force-exit tests/unit/riderCod.db.test.mjs",
    "test:recon-db": "node --test --test-force-exit tests/unit/financialReconciliation.db.test.mjs",
    "reconcile:readonly": "node src/scripts/financialReconciliation.js",
    "test:delivery-escrow-db": "node --test --test-force-exit tests/unit/deliveryEscrow.db.test.mjs",
    "test:delivery-methods": "node --test --test-force-exit tests/unit/deliveryMethods.unit.test.mjs",
    "test:seller-delivery-db": "node --test --test-force-exit tests/unit/deliveryAppSellerDelivery.db.test.mjs",
    "test:delivery-security-db": "node --test --test-force-exit tests/unit/deliverySecurity.db.test.mjs",
    "test:flows-db": "node --test --test-force-exit tests/unit/financeFlows.db.test.mjs",
    "test:approved-rules": "node --test --test-force-exit tests/unit/approvedRules.test.mjs",
    "test:exchange-gst-db": "node --test --test-force-exit tests/unit/exchangeGst.db.test.mjs",
    "test:commission-db": "node --test --test-force-exit tests/unit/commissionConfig.db.test.mjs",
    "test:payout-hold-db": "node --test --test-force-exit tests/unit/payoutHold.db.test.mjs",
    "test:order-expiry-db": "node --test --test-force-exit tests/unit/orderPaymentExpiry.db.test.mjs",
    "test:payment-switches-db": "node --test --test-force-exit tests/unit/paymentSwitches.db.test.mjs",
    "test:legacy": "node tests/unit/testRegisterValidation.js",
    "test:e2e:legacy": "node tests/e2e/wholesale.e2e.mjs && node tests/e2e/wholesaleVisibility.e2e.mjs && node tests/e2e/fireSafety.e2e.mjs && node tests/e2e/serviceBooking.e2e.mjs && node tests/e2e/deliveryAssignment.e2e.mjs && node tests/e2e/deliveryFlow.e2e.mjs"
  },
  "author": "furqan",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
