# ==============================================================================
# SAFE FIRE MULTI-VENDOR BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development: cp .env.example .env
# For Render deployment, add these keys in: Dashboard -> Environment Variables
# ==============================================================================

# ─── 1. SERVER CONFIGURATION ──────────────────────────────────────────────────
# Environment mode: 'development' or 'production'
NODE_ENV=development
# Port number (Render assigns PORT automatically in production)
PORT=5000
# Comma-separated list of allowed Frontend URLs for CORS and Socket.io
# In local development: http://localhost:5173
# In production: https://your-frontend-app.vercel.app,https://your-custom-domain.com
FRONTEND_URL=http://localhost:5173

# ─── 2. DATABASE CONFIGURATION (MongoDB Atlas) ────────────────────────────────
# For Render / Production, use your MongoDB Atlas Connection String:
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/safe-fire?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/safe-fire
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=5

# ─── 3. AUTHENTICATION & JWT SECURITY ─────────────────────────────────────────
# Generate high-entropy random secrets (e.g. using `openssl rand -hex 32`)
JWT_SECRET=your_jwt_access_secret_key_change_in_production_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── 4. CLOUDINARY ASSET STORAGE ──────────────────────────────────────────────
# Obtain these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── 5. EMAIL (SMTP SERVICE) ─────────────────────────────────────────────────
# Required for OTP verification, order confirmations, and reset password emails
# For Gmail, use an App Password (16 chars): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
FROM_NAME=Safe Fire Shop
FROM_EMAIL=noreply@yourdomain.com

# ─── 6. PAYMENT GATEWAY (Razorpay) ───────────────────────────────────────────
# Obtain from Razorpay Dashboard (Settings -> API Keys & Webhooks)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── 7. LOGISTICS & COURIER INTEGRATION (Optional / Live or Mock) ─────────────
# Set to 'true' to use built-in simulated logistics engine (mock shipping)
SHIPROCKET_MOCK_MODE=true
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# Delhivery Courier API (Optional)
DELHIVERY_TOKEN=
DELHIVERY_API_URL=https://track.delhivery.com
DELHIVERY_WEBHOOK_TOKEN=

# Google Maps API Key for Distance Calculation (Optional, defaults to Haversine formula)
GOOGLE_MAPS_API_KEY=
USE_GOOGLE_MAPS_ASSIGNMENT=false
