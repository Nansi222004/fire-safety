node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
backend/dist/
frontend/dist/
.next/
out/

# Uploads & Temp storage
uploads/
backend/uploads/
backend/uploads/tmp/
backend/uploads/delivery-docs/
backend/uploads/products/
tmp/
temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

